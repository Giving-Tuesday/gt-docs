---
import Base from '../../layouts/Base.astro';
import { getArticles } from '../../lib/articles';

const tags = [...new Set((await getArticles()).flatMap((article) => article.data.tags))].sort();
---
<Base title="Tags">
  <h1>Tags</h1>
  <ul>{tags.map((tag) => <li><a href={`/tags/${tag}/`}>{tag}</a></li>)}</ul>
</Base>
