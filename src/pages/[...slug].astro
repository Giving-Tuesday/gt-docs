---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { articleTitle, formatDate, getArticles, type Article } from '../lib/articles';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props as { article: Article };
const { Content } = await render(article);
const { date, tags } = article.data;
---
<Base title={articleTitle(article)}>
  <article>
    {article.data.title && <h1>{article.data.title}</h1>}
    <p class="meta">
      {date && formatDate(date)}
      {tags.map((tag) => <a href={`/tags/${tag}/`}>#{tag}</a>)}
    </p>
    <Content />
  </article>
</Base>
