---
import { articleTitle, formatDate, type Article } from '../lib/articles';

interface Props {
  articles: Article[];
}
const { articles } = Astro.props;
---
<ul>
  {
    articles.map((article) => (
      <li>
        <a href={`/${article.id}/`}>{articleTitle(article)}</a>
        {article.data.date && <span class="meta"> · {formatDate(article.data.date)}</span>}
      </li>
    ))
  }
</ul>
